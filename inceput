#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_TASKS 1000
#define MAX_TEXT 256

//structura pentru un task
typedef struct {
	int id;
	char titlu[MAX_TEXT];
	char descriere[MAX_TEXT];
	int prioritate; //de la 1 la 5
	char termen[11];
	int complet; //0=complet si 1 incomplet
}Task;

//heap de taskuri
typedef struct {
	Task taskuri[MAX_TASKS];
	int nr;//numar de taskuri;
}Heap;

Heap heap;
int id_curent = 1;

//compara taskuri, care are prooritate mai mare e mai important
//daca prioritatea e la fel, cel care e mai apropiat e mai important

int compara(Task a, Task b)
{
	if (a.prioritate != b.prioritate)
		return a.prioritate > b.prioritate;
	return strcmp(a.termen, b.termen) < 0;
}

//interschimbare 2 taskuri
void swap(Task* a, Task* b) {
	Task temp = *a;
	*a = *b;
	*b = temp;
}

//urcare in heap

void heap_up(int idx){
	while (idx > 0) {
		int parinte = (idx - 1) / 2;//formula pt gasirea parintelui-integer division
		if (compara(heap.taskuri[idx], heap.taskuri[parinte])) {
			swap(&heap.taskuri[idx], &heap.taskuri[parinte]);
			idx = parinte;
		}else break;
	}

}

//coborare in heap
void heap_down(int idx) {
	while (1) {
		int st = 2 * idx + 1;//gasirea copilului din stanga
		int dr = 2 * idx + 1;//gasirea copilului din dreapta dupa idx
		int max = idx;

		if (st < heap.nr && compara(heap.taskuri[st], heap.taskuri[max]))
			max = st;
		if (dr < heap.nr && compara(heap.taskuri[dr], heap.taskuri[max]))
			max = dr;


		if (max != idx) {
			swap(&heap.taskuri[idx], &heap.taskuri[max]);
			idx = max;
		}else break;
	
	}
}

//DATA si TIMP 

//obtine data curenta sub forma yyyy-mm-dd
void azi(char *buf) {
time_t now = time(NULL);
struct tm *t = localtime(&now);
sprintf(buf, "%04d-%02d-%02d",
t->tm_year + 1900, t->tm_mon + 1, t->tm_mday);
}


//verifica daca termenul este depasit
int este_overdue(char *termen) {
char curent[11];
azi(curent);
return strcmp(termen, curent) < 0;
}


//verifica daca taskul este pentru azi
int este_today(char *termen) {
char curent[11];
azi(curent);
return strcmp(termen, curent) == 0;
}

//OPERATII TASK 

//adaugare task 
void add_task(char *titlu, char *desc, int prioritate, char *termen, char *tags) {
    Task t;
    t.id = id_curent++;
    strcpy(t.titlu, titlu);
    strcpy(t.descriere, desc);
    strcpy(t.termen, termen);
    strcpy(t.tags, tags);
    t.prioritate = prioritate;
    t.complet = 0;

    heap.taskuri[heap.nr] = t;
    heap_up(heap.nr);
    heap.nr++;

    printf("Task adaugat cu succes! ID: %d\n", t.id);
	printf("Titlu: %s\n", t.titlu);
	printf("Prioritate: %d (FOARTE URGENT)\n", t.prioritate);
	printf("Termen: %s\n", t.termen);
	printf("Tags: %s\n", t.tags);
	printf("Lista salvata in tasks.json\n");
}

//listare task-uri (heapul este deja sortat logic) 
void list_tasks() {
    printf("ID | Titlu | Prioritate | Termen | Status\n");
    printf("---------------------------------------------\n");
    for (int i = 0; i < heap.nr; i++) {
        printf("%d | %s | %d | %s | %s\n",
               heap.taskuri[i].id,
               heap.taskuri[i].titlu,
               heap.taskuri[i].prioritate,
               heap.taskuri[i].termen,
               heap.taskuri[i].complet ? "Complet" : "Incomplet");
    }
}

//marcare task complet 
void complete_task(int id) {
    for (int i = 0; i < heap.nr; i++) {
        if (heap.taskuri[i].id == id) {
            heap.taskuri[i].complet = 1;
            printf("Task %d marcat complet!\n", id);
            return;
        }
    }
    printf("Task negasit!\n");
}

//editare prioritate
void edit_task(int id, int prioritate) {
    for (int i = 0; i < heap.nr; i++) {
        if (heap.taskuri[i].id == id) {
            heap.taskuri[i].prioritate = prioritate;
            heap_down(i);
            heap_up(i);
            printf("Task %d editat!\n", id);
            return;
        }
    }
}


//FILTRARI

void filter_overdue() {
for (int i = 0; i < heap.nr; i++)
if (!heap.taskuri[i].complet && este_overdue(heap.taskuri[i].termen))
printf("OVERDUE: %s (%s)\n", heap.taskuri[i].titlu, heap.taskuri[i].termen);
}


void filter_today() {
for (int i = 0; i < heap.nr; i++)
if (este_today(heap.taskuri[i].termen))
printf("TODAY: %s\n", heap.taskuri[i].titlu);
}


//STATISTICI

void stats() {
int total = heap.nr, comp = 0, over = 0;
for (int i = 0; i < heap.nr; i++) {
if (heap.taskuri[i].complet) comp++;
if (este_overdue(heap.taskuri[i].termen)) over++;
}


printf("Statistici:\n");
printf("Total: %d\n", total);
printf("Complete: %d\n", comp);
printf("Incomplete: %d\n", total - comp);
printf("Overdue: %d\n", over);
}

//FISIERE

void save_json() {
FILE *f = fopen("tasks.json", "w");
if (!f) return;

fprintf(f, "[\n");
for (int i = 0; i < heap.nr; i++) {
Task t = heap.taskuri[i];
fprintf(f,
" {\"id\":%d,\"titlu\":\"%s\",\"desc\":\"%s\",\"prioritate\":%d,\"termen\":\"%s\",\"tags\":\"%s\",\"complet\":%d}",
t.id, t.titlu, t.descriere, t.prioritate, t.termen, t.tags, t.complet);
if (i < heap.nr - 1) fprintf(f, ",");
fprintf(f, "\n");
}
fprintf(f, "]");
fclose(f);
}

//PARSARE

//cauta valoare dupa un flag cum ar fi priority 5
char* get_arg(int argc, char **argv, char *flag) {
    for (int i = 1; i < argc - 1; i++) {
        if (strcmp(argv[i], flag) == 0)
            return argv[i + 1];
    }
    return NULL;
}

//MAIN - CLI REAL

int main(int argc, char **argv) {
    heap.nr = 0;

    //verificare comanda
    if (argc < 2) {
        printf("Utilizare:");
        printf(" ./task_manager add \"Titlu\" --priority N --due YYYY-MM-DD --desc \"text\" --tags \"tag1,tag2\"");
        printf(" ./task_manager list");
        printf(" ./task_manager complete --id N");
        printf(" ./task_manager edit --id N --priority N");
        printf(" ./task_manager filter --overdue | --today");
        printf(" ./task_manager stats");
        return 0;
    }

//COMANDA ADD
    if (strcmp(argv[1], "add") == 0) {
        char *titlu = argv[2];
        char *p = get_arg(argc, argv, "--priority");
        char *d = get_arg(argc, argv, "--due");
        char *desc = get_arg(argc, argv, "--desc");
        char *tags = get_arg(argc, argv, "--tags");

        if (!titlu || !p || !d) {
            printf("Argumente lipsa pentru add!");
            return 0;
        }

        add_task(titlu,
                 desc ? desc : "",
                 atoi(p),
                 d,
                 tags ? tags : "");

        save_json();
        return 0;
    }

//COMANDA LIST
    if (strcmp(argv[1], "list") == 0) {
        list_tasks();
        return 0;
    }

//COMANDA COMPLETE
    if (strcmp(argv[1], "complete") == 0) {
        char *id = get_arg(argc, argv, "--id");
        if (!id) {
            printf("Specificati --id!");
            return 0;
        }
        complete_task(atoi(id));
        save_json();
        return 0;
    }

//COMANDA EDIT
    if (strcmp(argv[1], "edit") == 0) {
        char *id = get_arg(argc, argv, "--id");
        char *p = get_arg(argc, argv, "--priority");
        if (!id || !p) {
            printf("Specificati --id si --priority!");
            return 0;
        }
        edit_task(atoi(id), atoi(p));
        save_json();
        return 0;
    }
