#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_TASKS 1000
#define MAX_TEXT 256
//!
void load_json();

//structura pentru un task
typedef struct {
	int id;
	char titlu[MAX_TEXT];
	char descriere[MAX_TEXT];
	int prioritate; //de la 1 la 5
	char termen[11]; 
    char tags[MAX_TEXT]; 
	int complet; //0=incomplet si 1 complet
}Task;

//heap de taskuri
typedef struct {
	Task taskuri[MAX_TASKS];
	int nr;//numar de taskuri;
}Heap;

Heap heap;
int id_curent = 1;

//compara taskuri, care are prooritate mai mare e mai important
//daca prioritatea e la fel, cel care e mai apropiat e mai important

int compara(Task a, Task b)
{
	if (a.prioritate != b.prioritate)
		return a.prioritate > b.prioritate;
	return strcmp(a.termen, b.termen) < 0;
}

//interschimbare 2 taskuri
void swap(Task* a, Task* b) {
	Task temp = *a;
	*a = *b;
	*b = temp;
}

//urcare in heap

void heap_up(int idx){
	while (idx > 0) {
		int parinte = (idx - 1) / 2;//formula pt gasirea parintelui-integer division
		if (compara(heap.taskuri[idx], heap.taskuri[parinte])) {
			swap(&heap.taskuri[idx], &heap.taskuri[parinte]);
			idx = parinte;
		}else break;
	}

}

//coborare in heap
void heap_down(int idx) {
	while (1) {
		int st = 2 * idx + 1;//gasirea copilului din stanga
		int dr = 2 * idx + 2;//gasirea copilului din dreapta dupa idx
		int max = idx;

		if (st < heap.nr && compara(heap.taskuri[st], heap.taskuri[max]))
			max = st;
		if (dr < heap.nr && compara(heap.taskuri[dr], heap.taskuri[max]))
			max = dr;


		if (max != idx) {
			swap(&heap.taskuri[idx], &heap.taskuri[max]);
			idx = max;
		}else break;
	
	}
}

//DATA si TIMP 

//obtine data curenta sub forma yyyy-mm-dd
void azi(char *buf) {
time_t now = time(NULL);
struct tm *t = localtime(&now);
sprintf(buf, "%04d-%02d-%02d",
t->tm_year + 1900, t->tm_mon + 1, t->tm_mday);
}


//verifica daca termenul este depasit
int este_overdue(char *termen) {
char curent[11];
azi(curent);
return strcmp(termen, curent) < 0;
}


//verifica daca taskul este pentru azi
int este_today(char *termen) {
char curent[11];
azi(curent);
return strcmp(termen, curent) == 0;
}

//!!
int zile_ramase(char *termen) {
    struct tm t = {0};
    sscanf(termen, "%d-%d-%d", &t.tm_year, &t.tm_mon, &t.tm_mday);
    t.tm_year -= 1900;
    t.tm_mon -= 1;

    time_t deadline = mktime(&t);
    time_t now = time(NULL);

    return (int)((deadline - now) / (60 * 60 * 24));
}

int este_week(char *termen) {
    int z = zile_ramase(termen);
    return z >= 0 && z <= 7;
}


char* prioritate_text(int p) {
    if (p == 5) return "FOARTE URGENT";
    if (p == 4) return "URGENT";
    if (p == 3) return "MEDIU";
    if (p == 2) return "SCAZUT";
    return "FOARTE SCAZUT";
}


//OPERATII TASK 

//adaugare task 
void add_task(char *titlu, char *desc, int prioritate, char *termen, char *tags) {
    if (heap.nr >= MAX_TASKS) {
        printf("Prea multe task-uri!\n");
        return;
    }
    Task t;
    t.id = id_curent++;
    strcpy(t.titlu, titlu);
    strcpy(t.descriere, desc);
    strcpy(t.termen, termen);
    strcpy(t.tags, tags);
    t.prioritate = prioritate;
    t.complet = 0;

    heap.taskuri[heap.nr] = t;
    heap_up(heap.nr);
    heap.nr++;

    printf("Task adaugat cu succes! ID: %d\n", t.id);
	printf("Titlu: %s\n", t.titlu);
	printf("Prioritate: %d (%s)\n", t.prioritate, prioritate_text(t.prioritate));//!!!!!!
	printf("Termen: %s\n", t.termen);
	printf("Tags: %s\n", t.tags);
	printf("Lista salvata in tasks.json\n");
}

void list_tasks() {
    printf("--------------------------------------------------------------\n");
    printf("|ID |          Titlu      | Prioritate|    Termen   | Status |\n");
    printf("--------------------------------------------------------------\n");

    for (int i = 0; i < heap.nr; i++) {
        Task t = heap.taskuri[i];
        printf("| %-2d │ %-18s │ %-9d │ %-10s │ %-6s |\n",
               t.id,
               t.titlu,
               t.prioritate,
               t.termen,
               t.complet ? "OK" : "TODO");
    }

    printf("---------------------------------------------------------------\n");
}

//marcare task complet 
void complete_task(int id) {
    for (int i = 0; i < heap.nr; i++) {
        if (heap.taskuri[i].id == id) {
            heap.taskuri[i].complet = 1;
            printf("Task %d marcat complet!\n", id);
            return;
        }
    }
    printf("Task negasit!\n");
}

//editare prioritate
void edit_task(int id, int prioritate) {
    if (prioritate < 1 || prioritate > 5) {
        printf("Prioritate invalida! (1-5)\n");
        return;
    }

    for (int i = 0; i < heap.nr; i++) {
        if (heap.taskuri[i].id == id) {
            heap.taskuri[i].prioritate = prioritate;
            heap_down(i);
            heap_up(i);
            printf("Task %d editat!\n", id);
            return;
        }
    }
}


//FILTRARI

void filter_overdue() {
for (int i = 0; i < heap.nr; i++)
if (!heap.taskuri[i].complet && este_overdue(heap.taskuri[i].termen))
printf("OVERDUE: %s (%s)\n", heap.taskuri[i].titlu, heap.taskuri[i].termen);
}


void filter_today() {
for (int i = 0; i < heap.nr; i++)
if (!heap.taskuri[i].complet && este_today(heap.taskuri[i].termen))
printf("TODAY: %s\n", heap.taskuri[i].titlu);
}

void filter_week() {
    for (int i = 0; i < heap.nr; i++)
        if (!heap.taskuri[i].complet && este_week(heap.taskuri[i].termen))
            printf("WEEK: %s (%s)\n", heap.taskuri[i].titlu, heap.taskuri[i].termen);
}


//STATISTICI

void stats() {
int total = heap.nr, comp = 0, over = 0;
for (int i = 0; i < heap.nr; i++) {
if (heap.taskuri[i].complet) comp++;
if (!heap.taskuri[i].complet && este_overdue(heap.taskuri[i].termen)) over++;
}


printf("Statistici:\n");
printf("Total: %d\n", total);
printf("Complete: %d\n", comp);
printf("Incomplete: %d\n", total - comp);
printf("Overdue: %d\n", over);
}

//FISIERE

void save_json() {
FILE *f = fopen("tasks.json", "w");
if (!f) return;

fprintf(f, "[\n");
for (int i = 0; i < heap.nr; i++) {
Task t = heap.taskuri[i];
fprintf(f,
" {\"id\":%d,\"titlu\":\"%s\",\"desc\":\"%s\",\"prioritate\":%d,\"termen\":\"%s\",\"tags\":\"%s\",\"complet\":%d}",
t.id, t.titlu, t.descriere, t.prioritate, t.termen, t.tags, t.complet);
if (i < heap.nr - 1) fprintf(f, ",");
fprintf(f, "\n");
}
fprintf(f, "]");
fclose(f);
}


void load_json() {
    FILE *f = fopen("tasks.json", "r");
    if (!f) return;

    heap.nr = 0;

    while (!feof(f)) {
        Task t;
        char line[1024];

        if (!fgets(line, sizeof(line), f))
            break;

        if (sscanf(line,
            " {\"id\":%d,\"titlu\":\"%[^\"]\",\"desc\":\"%[^\"]\",\"prioritate\":%d,\"termen\":\"%[^\"]\",\"tags\":\"%[^\"]\",\"complet\":%d}",
            &t.id,
            t.titlu,
            t.descriere,
            &t.prioritate,
            t.termen,
            t.tags,
            &t.complet) == 7) {

           if (heap.nr >= MAX_TASKS)
             break;
            heap.taskuri[heap.nr] = t;
            heap.nr++;

            if (t.id >= id_curent)
                id_curent = t.id + 1;
        }
    }

    fclose(f);

    // reconstruim heap-ul
    for (int i = heap.nr / 2 - 1; i >= 0; i--)
        heap_down(i);
}

//PARSARE

//cauta valoare dupa un flag cum ar fi priority 5
char* get_arg(int argc, char **argv, char *flag) {
    for (int i = 1; i < argc - 1; i++) {
        if (strcmp(argv[i], flag) == 0)
            return argv[i + 1];
    }
    return NULL;
}
int are_flag(int argc, char **argv, char *flag) {
    for (int i = 1; i < argc; i++)
        if (strcmp(argv[i], flag) == 0)
            return 1;
    return 0;
}


//MAIN - CLI REAL

int main(int argc, char **argv) {
    heap.nr = 0;
    load_json(); //!!


    //verificare comanda
    if (argc < 2) {
        printf("Utilizare:\n");
        printf(" ./task_manager add \"Titlu\" --priority N --due YYYY-MM-DD --desc \"text\" --tags \"tag1,tag2\"");
        printf(" ./task_manager list\n");
        printf(" ./task_manager complete --id N\n");
        printf(" ./task_manager edit --id N --priority N\n");
        printf(" ./task_manager filter --overdue | --today\n");
        printf(" ./task_manager stats\n");
        return 0;
    }

//COMANDA ADD
    if (strcmp(argv[1], "add") == 0) {
        char *titlu = argv[2];
        char *p = get_arg(argc, argv, "--priority");
        char *d = get_arg(argc, argv, "--due");
        char *desc = get_arg(argc, argv, "--desc");
        char *tags = get_arg(argc, argv, "--tags");

        if (!titlu || !p || !d) {
            printf("Argumente lipsa pentru add!");
            return 0;
        }

        add_task(titlu,
                 desc ? desc : "",
                 atoi(p),
                 d,
                 tags ? tags : "");

        save_json();
        return 0;
    }

//COMANDA LIST
    if (strcmp(argv[1], "list") == 0) {
     if (get_arg(argc, argv, "--sorted")) {
        
     }
     list_tasks();
     return 0;
    }


//COMANDA COMPLETE
    if (strcmp(argv[1], "complete") == 0) {
        char *id = get_arg(argc, argv, "--id");
        if (!id) {
            printf("Specificati --id!");
            return 0;
        }
        complete_task(atoi(id));
        save_json();
        return 0;
    }

//COMANDA EDIT
    if (strcmp(argv[1], "edit") == 0) {
        char *id = get_arg(argc, argv, "--id");
        char *p = get_arg(argc, argv, "--priority");
        if (!id || !p) {
            printf("Specificati --id si --priority!");
            return 0;
        }
        edit_task(atoi(id), atoi(p));
        save_json();
        return 0;
    }


//COMANDA FILTER 

if (strcmp(argv[1], "filter") == 0) {
    if (are_flag(argc, argv, "--overdue")) {
        filter_overdue();
        return 0;
    }
    if (are_flag(argc, argv, "--today")) {
        filter_today();
        return 0;
    }
    if (are_flag(argc, argv, "--week")) {
        filter_week();
        return 0;
    }

    printf("Optiune filter necunoscuta!\n");
    return 0;
}

//COMANDA STATS
    if (strcmp(argv[1], "stats") == 0) {
        stats();
        return 0;
    }

    if (strcmp(argv[1], "export") == 0) {
        save_json();
        printf("Export realizat in tasks.json\n");
        return 0;
    }

    printf("Comanda necunoscuta!");
    return 0;
}
